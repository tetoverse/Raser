{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Raser",
  "version": "2.0.1",
  "identifier": "io.github.darkness38.raser",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "windows": [
      {
        "title": "Raser",
        "width": 1280,
        "height": 820,
        "minWidth": 400,
        "minHeight": 550,
        "resizable": true,
        "fullscreen": false,
        "decorations": false,
        "transparent": false,
        "additionalBrowserArgs": "--enable-features=HardwareMediaKeyHandling,MediaSessionService,CalculateNativeWinOcclusion --renderer-process-limit=1 --js-flags=\"--max-old-space-size=128 --expose-gc\" --disable-gpu-shader-disk-cache --disk-cache-size=10485760 --media-cache-size=10485760 --disable-features=AudioServiceOutOfProcess,Translate,BackForwardCache"
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}